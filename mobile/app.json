{
  "expo": {
    "name": "FleetOZ",
    "slug": "fleeto-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "fleetoz",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1A0B33"
    },
    "backgroundColor": "#1A0B33",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fleetoz.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A0B33"
      },
      "package": "com.fleetoz.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "4978aebc-727e-4414-8865-a1f4f7e54333"
      }
    }
  }
}
